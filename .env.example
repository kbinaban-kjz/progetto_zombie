# ==============================================================================
# INVESTIGATORE AI (Protocollo Lazzaro) — Configurazione Ambiente (.env.example)
#
# Copia questo file in .env e inserisci la tua chiave API:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API (Consigliato per velocità, quote generose e ragionamento)
# ------------------------------------------------------------------------------
# Ottieni la chiave gratuita su Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tuo_api_key_gemini_qui

# In alternativa è supportato anche l'alias GEMINI_API:
# GEMINI_API=tuo_api_key_gemini_qui

# Modello Gemini da utilizzare:
#   - gemini-3.8-flash-lite (consigliato, ultra veloce ed economico con ottime capacità di analisi)
#   - gemini-3.8-flash (modello standard, bilanciato e potente)
#   - gemini-flash-lite-latest (punta sempre all'ultima versione di Flash Lite)
#   - gemini-3.5-flash (ottima velocità per query sul dossier)
#   - gemini-flash-latest (punta sempre all'ultima versione standard)
#   - gemini-3.1-pro-preview (massima profondità di ragionamento)
GEMINI_MODEL=gemini-3.8-flash-lite

# ------------------------------------------------------------------------------
# NVIDIA NIM API (Opzionale — Llama 3 / Nemotron)
# ------------------------------------------------------------------------------
# Ottieni la chiave su: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-tuo_token_nvidia_qui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ------------------------------------------------------------------------------
# OPENAI API (Opzionale — GPT-4o / GPT-4o-mini)
# ------------------------------------------------------------------------------
# Ottieni la chiave su: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tuo_token_openai_qui
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# SERVER HTTP & DATABASE SQLITE (Opzionali)
# ------------------------------------------------------------------------------
PORT=8000
SQLITE_DB_PATH=Backend/cronologia.db

